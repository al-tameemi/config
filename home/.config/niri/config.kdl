// Niri base config — https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

// ---------- Input ----------
input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    mouse {
        accel-profile "flat"
    }

    focus-follows-mouse max-scroll-amount="0%"
}

// ---------- Outputs ----------
// Run `niri msg outputs` to list names.
output "DP-3" {
    mode "3840x2160@239.991"
    scale 1.5
    position x=0 y=0
    // Only enable VRR while a window with variable-refresh-rate=true is shown
    variable-refresh-rate on-demand=true
}

output "HDMI-A-1" {
    mode "1920x1080@74.973"
    scale 1
    // DP-3 is 2560x1440 logical; y=360 vertically centers this 1080p screen
    position x=2560 y=360
}

// ---------- Layout ----------
layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-gradient from="#8a5cf0" to="#4fe0b8" angle=45
        inactive-color "#3a3347"
    }

    border {
        off
    }

    // Slight drop shadow behind windows
    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=6
        color "#00000050"
    }

}

// ---------- General ----------
prefer-no-csd
hotkey-overlay { skip-at-startup; }
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

cursor {
    xcursor-size 24
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland"
    // Steam is an X11 app and ignores the 1.5 output scale; scale its UI manually
    STEAM_FORCE_DESKTOPUI_SCALING "1.5"
}

// ---------- Startup ----------
// spawn-at-startup "waybar"   // replaced by Dux Shell (programs.dux-shell, systemd user service)
spawn-at-startup "mako"
spawn-at-startup "awww-daemon"
// Wallpaper: wait for the daemon to be ready, then set the image
spawn-at-startup "sh" "-c" "until awww query >/dev/null 2>&1; do sleep 0.2; done; awww img $HOME/Pictures/wallpapers/wallhaven-rqjgym.png --transition-type grow --transition-duration 1.5"
spawn-at-startup "xwayland-satellite"
// Named workspaces start first; push "games" toward the end so Mod+1..9 stay on normal workspaces
spawn-at-startup "sh" "-c" "sleep 2; niri msg action move-workspace-to-index --reference games 99"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"

// ---------- Window rules ----------
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// Work around WezTerm's initial configure bug.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Firefox picture-in-picture floats.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Discord always opens on the second monitor.
window-rule {
    match app-id=r#"^discord$"#
    open-on-output "HDMI-A-1"
}

// ---------- Gaming ----------
// Dedicated workspace that games open on (lives on the main monitor).
workspace "games" {
    open-on-output "DP-3"
}

// Steam games (native + Proton) and common launchers/runtimes.
window-rule {
    match app-id=r#"^steam_app_\d+$"#
    match app-id=r#"^gamescope$"#
    match app-id=r#"^cs2$"#
    match app-id=r#"^dota2$"#
    match app-id=r#"^minecraft"#
    match app-id=r#"^org\.prismlauncher\."#
    match app-id=r#"\.exe$"#
    open-on-workspace "games"
    // No open-fullscreen: it was also forcing popups ("Exit game?" dialogs) fullscreen.
    // Games request fullscreen themselves; dialogs stay floating.
    variable-refresh-rate true
    geometry-corner-radius 0
    clip-to-geometry false
    draw-border-with-background false
    shadow { off; }
}

// Steam client: only the main window (titled exactly "Steam") opens at 100% width.
window-rule {
    match app-id=r#"^steam$"# title=r#"^Steam$"#
    default-column-width { proportion 1.0; }
}

// Steam client: keep main window tiled, pop up helpers as floating.
window-rule {
    match app-id=r#"^steam$"# title=r#"^(Friends List|Steam Settings|Steam - News|Screenshot Uploader|Special Offers|Sign in to Steam)"#
    match app-id=r#"^steam$"# title=r#"^notificationtoasts"#
    open-floating true
}

// Wine/Proton helper windows without a proper title are often tiny dialogs.
window-rule {
    match app-id=r#"^steam_proton$"#
    open-floating true
}

// Don't capture games in screencasts / screenshots of other windows by accident.
// (Uncomment to hide them from screen sharing.)
// window-rule {
//     match app-id=r#"^steam_app_\d+$"#
//     block-out-from "screencast"
// }

// ---------- Keybinds ----------
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps
    Mod+Return { spawn "alacritty"; }
    Mod+D      { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+Ctrl+V { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Shift+L { spawn "dms" "ipc" "call" "lock" "lock"; }

    // Audio / brightness
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Overview & windows
    Mod+O repeat=false { toggle-overview; }
    Mod+G { focus-workspace "games"; }
    Mod+Ctrl+G { move-column-to-workspace "games"; }
    Mod+Space repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    // Focus
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Move
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }

    // Monitors
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }

    // Workspaces
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Mouse wheel
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    // Plain wheel (no horizontal tilt): Shift+wheel scrolls between columns
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }
    Mod+Shift+Ctrl+WheelScrollDown { move-column-right; }
    Mod+Shift+Ctrl+WheelScrollUp   { move-column-left; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Column/window management
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R  { reset-window-height; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C       { center-column; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W       { toggle-column-tabbed-display; }

    // Screenshots
    Print      { screenshot; }
    Mod+Shift+S { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Session
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
}
