{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 8,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["niri/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
        "tray",
        "pulseaudio#out",
        "custom/mic",
        "network#eth",
        "network#wifi",
        "custom/power"
    ],

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "<span size='large'></span>",
            "default": "<span size='large'></span>",
            "empty": "<span size='large'></span>"
        }
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "interval": 1
    },

    // Output volume: scroll = +/-5%, click = mute, right-click = mixer
    "pulseaudio#out": {
        "format": "{icon} {volume}%",
        "format-muted": "<span size='large'></span> muted",
        "format-icons": {
            "headphone": "<span size='large'></span>",
            "default": ["<span size='large'></span>", "<span size='large'></span>", "<span size='large'></span>"]
        },
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip-format": "{desc}"
    },

    // Input volume: scroll = +/-5%, click = mute, right-click = mixer
    "custom/mic": {
        "exec": "~/.config/waybar/scripts/mic.sh",
        "return-type": "json",
        "interval": 2,
        "signal": 8,
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+; pkill -RTMIN+8 waybar",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-; pkill -RTMIN+8 waybar",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; pkill -RTMIN+8 waybar",
        "on-click-right": "pavucontrol --tab=4"
    },

    "network#eth": {
        "interface": "eno1",
        "format-ethernet": "<span size='large'></span> {ipaddr}",
        "format-disconnected": "<span size='large'></span> down",
        "format-linked": "<span size='large'></span> no IP",
        "tooltip-format": "{ifname}\n{ipaddr}/{cidr}\n↑ {bandwidthUpBytes}  ↓ {bandwidthDownBytes}",
        "interval": 5
    },

    // Click opens a fuzzel menu listing nearby Wi-Fi networks
    "network#wifi": {
        "interface": "wlp13s0",
        "format-wifi": "<span size='large'></span> {essid} ({signalStrength}%)",
        "format-disconnected": "<span size='large'></span> off",
        "format-disabled": "<span size='large'></span> off",
        "tooltip-format-wifi": "{essid}\n{ipaddr}\nSignal: {signalStrength}%  {frequency} GHz",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-right": "nm-connection-editor",
        "interval": 5
    },

    // System tray: right-click an icon (Steam, Discord, ...) for Exit/Quit
    "tray": {
        "icon-size": 20,
        "spacing": 10,
        "show-passive-items": true
    },

    "custom/power": {
        "format": "<span size='large'></span>",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    }
}
